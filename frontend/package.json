{
  "name": "dashboard-frontend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "container",
    "micro-activity",
    "micro-projects",
    "micro-skills",
    "micro-stats"
  ],
  "scripts": {
    "dev": "concurrently \"npm -w container run dev\" \"npm -w micro-activity run dev\" \"npm -w micro-projects run dev\" \"npm -w micro-skills run dev\" \"npm -w micro-stats run dev\"",
    "dev:container": "npm -w container run dev",
    "dev:activity": "npm -w micro-activity run dev",
    "dev:projects": "npm -w micro-projects run dev",
    "dev:skills": "npm -w micro-skills run dev",
    "dev:stats": "npm -w micro-stats run dev",
    "build": "npm run build --workspaces",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "html-webpack-plugin": "^5.6.7",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3"
  },
  "dependencies": {
    "dashboard-mern-vanilla": "file:.."
  }
}
